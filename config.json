    "forms": {
      "partner-enquiry": {
        "title": "Partner with Times Internet Languages Live",
        "intro": "Fill in your details and our team will get back to you.",
        "submitUrl": "/api/forms/partner-enquiry",
        "submitText": "Submit Interest",
        "successMessage": "Thank you! We've received your interest. Our partnerships team will reach out within 24 hours.",
        "fields": [
          {
            "name": "fullName",
            "label": "Full Name",
            "type": "text",
            "required": true,
            "placeholder": "Your full name",
            "autocomplete": "name"
          },
          {
            "name": "phone",
            "label": "Phone Number",
            "type": "tel",
            "required": true,
            "placeholder": "+91 9876543210",
            "autocomplete": "tel"
          },
          {
            "name": "email",
            "label": "Email",
            "type": "email",
            "required": true,
            "placeholder": "you@company.com",
            "autocomplete": "email"
          },
          {
            "name": "designation",
            "label": "Designation",
            "type": "text",
            "required": true,
            "placeholder": "VP Marketing",
            "autocomplete": "organization-title"
          },
          {
            "name": "company",
            "label": "Company",
            "type": "text",
            "required": true,
            "placeholder": "Acme Corp",
            "autocomplete": "organization"
          },
          {
            "name": "note",
            "label": "Add a Note (optional)",
            "type": "textarea",
            "required": false,
            "placeholder": "Tell us about your interest or questions..."
          },
          {
            "name": "optComms",
            "label": "I agree to receive further communication via WhatsApp and email",
            "type": "checkbox",
            "required": false
          },
          {
            "name": "optTerms",
            "label": "I agree to the Terms & Conditions and Privacy Policy",
            "type": "checkbox",
            "required": true,
            "checked": true,
            "links": [
              {
                "text": "Terms & Conditions",
                "href": "https://timeslanguages.in/termsandconditions"
              },
              {
                "text": "Privacy Policy",
                "href": "https://timeslanguages.in/privacypolicy"
              }
            ]
          }
        ]
      }
    },
